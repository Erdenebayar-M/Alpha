# Point the app at the real backend. src/api/client.ts hits ${EXPO_PUBLIC_API_URL}/api/*.
# Use this PC's LAN IP so a real phone on the same Wi-Fi can reach the Hono server
# (bound to 0.0.0.0:3000). Restart Expo with `npx expo start -c` after changing this
# so the value is re-inlined.
EXPO_PUBLIC_API_URL=http://192.168.1.8:3000

# Optional dev-only fake backend (no server needed, no real auth). Never has any
# effect outside __DEV__ — a release build cannot enable this even if it leaked
# into the bundle. Set to 1 to use it instead of EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_USE_MOCK=1
