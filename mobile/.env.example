# Point the app at the real backend. When set, src/api/client.ts leaves mock mode
# and hits ${EXPO_PUBLIC_API_URL}/api/*. Use this PC's LAN IP so a real phone on the
# same Wi-Fi can reach the Hono server (bound to 0.0.0.0:3000). Restart Expo with
# `npx expo start -c` after changing this so the value is re-inlined.
EXPO_PUBLIC_API_URL=http://192.168.1.8:3000
