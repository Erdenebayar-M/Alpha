# Copy to .env.local (gitignored) for local dev. These are read only by
# server-side code (route handlers under app/api/*, server components and
# proxy.ts) — never exposed to the browser, so no NEXT_PUBLIC_ prefix.

# Where the backend (npm run dev:backend, from the repo root) is listening.
# The Diagnostic runs as whichever parent is signed in on web; `npm run seed`
# (repo root) creates test@local.dev / password123 to sign in with.
BACKEND_URL=http://localhost:3001

# Deployment note (sign-in rate limit): web must be deployed behind a proxy that
# overwrites X-Forwarded-For; otherwise the sign-in rate limit can be bypassed.
# See docs/adr/0006-parent-session-on-web-origin.md.

# Google sign-in: the OAuth client's public ID (never the secret — only the
# backend holds GOOGLE_CLIENT_SECRET). Unset, the Google button and "Эсвэл"
# divider are hidden. Register <web origin>/api/auth/google/callback as an
# authorized redirect URI on the client.
GOOGLE_CLIENT_ID=
# The site's public origin (no trailing slash), used to build the Google
# redirect_uri and redirects. Required in production behind a proxy; unset,
# the request's own origin is used, which is right for local dev.
# WEB_ORIGIN=https://www.orto.my

# Dev deploys only (Vercel Preview env; never Production): when set, every page
# asks for this shared password first and the whole site is sent as noindex.
# Unset, there is no gate. Use 24+ random characters: there is no attempt
# limit, and the cookie is an unkeyed hash of it. See
# docs/adr/0008-dev-site-password-gate.md.
# DEV_SITE_PASSWORD=

# Dev deploys only (Vercel Preview env; never Production): the feedback widget.
# With FEEDBACK_ENABLED=1 and a token, every page shows a feedback button that
# files a GitHub issue (labelled needs-triage) on this repo. The token is a
# fine-grained PAT limited to this repo with only "Issues: Read and write";
# it stays server-side. Ignored when VERCEL_ENV=production. See
# docs/adr/0009-dev-feedback-widget.md.
# FEEDBACK_ENABLED=1
# FEEDBACK_GITHUB_TOKEN=
# Optional, same Preview-only rule: with these set the widget also accepts one
# screenshot, stored under the feedback/ prefix of the content pipeline's R2
# bucket and embedded in the issue. Use an R2 API token limited to that prefix.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
