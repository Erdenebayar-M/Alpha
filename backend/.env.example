# Database (Postgres on port 5433 locally; Neon/Railway URL in hosted envs)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5433/mongolian_app?schema=public"

# Server
NODE_ENV=development
PORT=3000

# Load testing — disable rate limiting (dev only; ignored when NODE_ENV=production).
# Leave unset for normal use.
# RATE_LIMIT_DISABLED=true

# Auth
JWT_SECRET=generate_with__node_-e_"console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Admin routes (/api/admin/*) — static bearer secret, min 32 chars
ADMIN_SECRET=generate_a_long_random_string_min_32_chars

# Content pipeline — AI providers
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...

# Content pipeline — Cloudflare R2 (asset storage). Optional unless running
# pipeline:upload-audio / pipeline:upload-images.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# Seeding guard (leave empty; set to "true" only for intentional prod reseeds)
# ALLOW_PROD_SEED=
