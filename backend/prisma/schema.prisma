// Mongolian Spelling & Dictation App — Phase 1 Content Schema
// Prisma 7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Variant {
  A // Grades 1–2, gamified, 5–8 min sessions
  B // Grades 2–4, structured, 10–15 min sessions
}

enum LevelCode {
  M0
  M1
  M2
  M3
  M4
  M5
}

enum SkillCode {
  S1 // Үсэг-авиа ялгалт (Letter-sound discrimination)
  S2 // Үгийн зөв бичлэг (Word spelling)
  S3 // Урт/богино эгшиг (Long/short vowel)
  S4 // Балархай эгшиг (Reduced vowel)
  S5 // Залгавар, нөхцөл (Suffix/agreement)
  S6 // Өгүүлбэрийн тэмдэглэгээ (Punctuation/caps)
  S7 // Сонсголоор буулгах (Dictation)
  S8 // Алдаа засах (Error correction)
}

enum ErrorCode {
  // A — Үсэг-авиа зөрөөтэй алдаа (Letter-sound errors)
  A1 // Авиа андуурах (Sound confusion)
  A2 // Үсэг солих (Letter substitution)
  A3 // Үеийн бүтэц алдах (Syllable structure error)
  // B — Үсгийн бүтцийн алдаа (Letter structure errors)
  B1 // Үсэг орхих (Letter omission — catch-all)
  B2 // Үсэг илүү бичих (Extra letter)
  B3 // Үсгийн байрлал солих (Letter transposition)
  B4 // Үгийн хэсэг орхих (Word-chunk omission)
  // C — Эгшгийн алдаа (Vowel errors)
  C1 // Урт эгшиг орхих (Long vowel omission)
  C2 // Урт эгшиг илүүдэх (Long vowel excess)
  C3 // Эгшиг андуурах (Vowel confusion)
  C4 // Балархай эгшиг орхих (Reduced vowel omission)
  C5 // Балархай эгшиг илүүдэх (Reduced vowel excess)
  C6 // Эгшгийн зохицлын алдаа (Vowel harmony error)
  // D — Гийгүүлэгчийн алдаа (Consonant errors)
  D1 // Гийгүүлэгч орхих (Consonant omission)
  D2 // Гийгүүлэгч илүүдэх (Extra consonant)
  D3 // Гийгүүлэгч андуурах (Consonant confusion)
  D4 // Давхар гийгүүлэгчийн алдаа (Double consonant error)
  D5 // Үгийн төгсгөлийн гийгүүлэгч (Word-final consonant error)
  // E — Залгавар/нөхцөлийн алдаа (Suffix errors)
  E1 // Залгавар орхигдол (Suffix omission)
  E2 // Буруу залгавар сонголт (Wrong suffix selection)
  E3 // Эр/эм залгаврын алдаа (Gender-harmony suffix error)
  E4 // Тийн ялгалын алдаа (Case suffix error)
  E5 // Олон тоо/харьяаллын алдаа (Plural/possessive error)
  E6 // Үйл үгийн хувиллын алдаа (Verb conjugation error)
  E7 // Залгаврын бичлэгийн алдаа (Suffix spelling error)
  // F — Үгийн хэлбэр/бүтцийн алдаа (Word-form errors)
  F1 // Язгуур үгийн хэлбэрийн алдаа (Root word form error)
  F2 // Нийлмэл үгийн алдаа (Compound word error)
  F3 // Үгийн аймгийн хэлбэрийн алдаа (Part-of-speech form error)
  F4 // Давталттай буруу хэвшил (Repeated incorrect habit)
  // G — Өгүүлбэрийн тэмдэглэгээний алдаа (Punctuation/caps errors)
  G1 // Том үсгийн алдаа (Capitalization error)
  G2 // Цэг орхигдол (Missing full stop)
  G3 // Асуулт/анхааруулах тэмдгийн алдаа (Question/exclamation mark error)
  G4 // Таслалын алдаа (Comma error)
  G5 // Өгүүлбэрийн хил заагийн алдаа (Sentence boundary error)
  // H — Сонсгол/анхаарал/тогтвортой байдлын алдаа (Listening/attention errors)
  H1 // Сонсгол тасарсан алдаа (Listening comprehension error)
  H2 // Хурдны алдаа (Speed/fluency error — metric-derived)
  H3 // Анхаарлын хэлбэлзлийн алдаа (Attention variability — metric-derived)
  H4 // Өөрийгөө шалгаагүй алдаа (Failed self-check)
}

enum TaskType {
  // 37 v3 types (Дасгалын_төрлүүд_каталог_v3.xlsx)
  TT_1_1
  TT_1_2
  TT_1_3
  TT_1_4
  TT_1_5
  TT_2_1
  TT_2_2
  TT_2_3
  TT_2_4
  TT_2_5
  TT_2_6
  TT_3_1
  TT_3_2
  TT_3_3
  TT_3_4
  TT_3_5
  TT_4_1
  TT_4_2
  TT_4_3
  TT_4_4
  TT_4_5
  TT_5_1
  TT_5_2
  TT_5_3
  TT_5_4
  TT_5_5
  TT_5_6
  TT_5_7
  TT_6_1
  TT_6_2
  TT_6_3
  TT_6_4
  TT_7_1
  TT_7_2
  TT_7_3
  TT_7_4
  TT_7_5
  TT_7_6
  TT_7_7
  TT_8_1
  TT_8_2
  TT_8_3
  TT_8_4
}

enum InteractionForm {
  CHOOSE     // Сонгох — tap/click one option
  MATCH      // Холбох — drag/tap to pair items
  FILL       // Нөхөх — type into a blank
  ASSEMBLE   // Угсрах — arrange tiles in order
  TRANSCRIBE // Буулгах — dictation / copy-write
  CORRECT    // Засах — find and fix an error
  TAP        // Товших — tap a specific word in text
}

enum LessonSlot {
  WARM_UP
  CORE
  MIXED
  END
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum DiagnosticPhase {
  PHASE_A // 8 non-adaptive screening tasks
  PHASE_B // 8 adaptive follow-up on weak skills
  PHASE_C // 4 boundary validation tasks
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PlanTemplate {
  BALANCED
  INTENSIVE
  STABILIZATION
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  REPLACED
}

enum PlanSource {
  DIAGNOSTIC
  CHECKPOINT
  MANUAL
}

enum TaskSource {
  HUMAN // authored by hand, seed data, or content-pipeline scripts
  AI    // produced by the LLM generation pipeline
}

enum LessonStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CheckpointDecision {
  CONTINUE_PLAN
  NEW_PLAN
  LEVEL_UP
}

enum CheckpointStatus {
  PENDING
  COMPLETED
}

enum AttemptContext {
  DIAGNOSTIC
  LESSON
  CHECKPOINT
}

enum DraftStage {
  STAGE1
  STAGE2
  FLAGGED
  NEEDS_REVISION
  REJECTED
}

// ─── Tables ──────────────────────────────────────────────────────────────────

model Parent {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  learners Learner[]

  @@map("parents")
}

model Learner {
  id            String   @id @default(uuid())
  parent_id     String
  name          String
  grade         Int
  daily_minutes Int      @default(10)
  variant       Variant
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  parent              Parent              @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  skill_state         LearnerSkillState?
  diagnostic_sessions DiagnosticSession[]
  plans               Plan[]
  lessons             Lesson[]
  attempts            Attempt[]

  @@map("learners")
}

model LearnerSkillState {
  id            String    @id @default(uuid())
  learner_id    String    @unique
  general_level LevelCode @default(M0)

  // Per-skill scores (0.0 – 1.0, weighted average)
  s1_score Float @default(0)
  s2_score Float @default(0)
  s3_score Float @default(0)
  s4_score Float @default(0)
  s5_score Float @default(0)
  s6_score Float @default(0)
  s7_score Float @default(0)
  s8_score Float @default(0)

  // Per-skill levels (derived from score thresholds)
  s1_level LevelCode @default(M0)
  s2_level LevelCode @default(M0)
  s3_level LevelCode @default(M0)
  s4_level LevelCode @default(M0)
  s5_level LevelCode @default(M0)
  s6_level LevelCode @default(M0)
  s7_level LevelCode @default(M0)
  s8_level LevelCode @default(M0)

  // Per-skill confidence (based on item count)
  s1_confidence Confidence @default(LOW)
  s2_confidence Confidence @default(LOW)
  s3_confidence Confidence @default(LOW)
  s4_confidence Confidence @default(LOW)
  s5_confidence Confidence @default(LOW)
  s6_confidence Confidence @default(LOW)
  s7_confidence Confidence @default(LOW)
  s8_confidence Confidence @default(LOW)

  // Analytics & planning fields
  top_error_codes          String[] // Top 3 most frequent error codes
  weak_skills              String[] // Current 2–3 weakest skills e.g. ["S3","S5"]
  recent_error_codes       String[] // Last 7 days error codes
  recent_task_ids          String[] // Last 20 task IDs (dedup guard)
  preferred_session_length Int      @default(10) // 10 / 15 / 20
  current_streak           Int      @default(0)
  longest_streak           Int      @default(0)

  updated_at DateTime @updatedAt @db.Timestamptz(6)

  learner Learner @relation(fields: [learner_id], references: [id], onDelete: Cascade)

  @@map("learner_skill_states")
}

/// Draft tasks in the content pipeline. Separate from live Task table.
model TaskDraft {
  id                     String     @id
  task_id                String
  stage                  DraftStage
  task_type              TaskType
  prompt_text            String
  correct_answer         String
  options                Json
  audio_url              String?
  prompt_audio_url       String?
  image_url              String?
  primary_skill          SkillCode
  secondary_skill        SkillCode?
  level_target           String
  error_targets          String[]
  grade_band             String[]
  difficulty             Int
  estimated_time_seconds Int
  lesson_slot_fit        LessonSlot
  interaction_form       InteractionForm?
  feedback_text          String
  feedback_correct       String?
  feedback_wrong         String?
  is_diagnostic          Boolean    @default(false)
  source                 TaskSource @default(HUMAN)

  ai_review_severity     String?
  ai_review_issues       String[]   @default([])
  ai_fix_suggestion      String?
  ai_reviewed_at         DateTime?  @db.Timestamptz(6)

  reviewer_notes         String?
  flag_reason            String?
  revision_reason        String?
  rejection_reason       String?

  created_at             DateTime   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime   @updatedAt      @db.Timestamptz(6)

  audit_logs             TaskDraftAuditLog[]

  @@index([task_id])
  @@index([stage])
  @@index([stage, primary_skill])
  @@index([grade_band], type: Gin)
  @@map("task_drafts")
}

/// Audit trail for all pipeline actions (approve/reject/flag/revise/edit).
model TaskDraftAuditLog {
  id           String      @id @default(uuid())
  draft_id     String?
  task_id      String
  action       String
  from_stage   DraftStage
  to_stage     DraftStage?
  reason       String?
  notes        String?
  snapshot     Json
  performed_at DateTime    @default(now()) @db.Timestamptz(6)

  draft        TaskDraft?  @relation(fields: [draft_id], references: [id], onDelete: SetNull)

  @@index([draft_id])
  @@index([task_id])
  @@map("task_draft_audit_logs")
}

/// Seed-content word bank. Standalone — not linked to Learner.
model Word {
  id              String   @id // W001, W002, …
  word            String
  category        String
  grade_band      String[] // ["G1"], ["G1","G2"], ["G2"], etc.
  char_count      Int
  syllable_count  Int
  skill_tags      String[] // ["S1","S2"]
  error_tags      String[] // ["A2","B1"]
  image_ok        Boolean
  audio_ok        Boolean
  image_prompt    String?
  audio_text      String?
  sample_sentence String?
  distractors     String[] // Incorrect choices for TT1
  blank_hint      String?  // Hint text for TT2

  @@index([grade_band], type: Gin)
  @@index([skill_tags], type: Gin)
  @@map("words")
}

/// Task bank. Standalone — not linked to a specific Learner.
/// Task.id is human-readable, e.g. "G12-001", "G24-001".
model Task {
  id                     String     @id // G12-001, G24-001, etc.
  task_type              TaskType
  prompt_text            String
  correct_answer         String
  /// JSONB — structure varies by TaskType (see TT1–TT6 in Pre_Coding_Design_Document)
  options                Json
  audio_url              String?
  image_url              String?
  primary_skill          SkillCode
  secondary_skill        SkillCode?
  level_target           String     // M0, M1, M1-M2, M2, …
  error_targets          String[]   // ["C1","C2"]
  grade_band             String[]   // ["G1"], ["G1","G2"], etc.
  difficulty             Int        // 1–5
  estimated_time_seconds Int
  lesson_slot_fit        LessonSlot
  interaction_form       InteractionForm?
  feedback_text          String
  feedback_correct       String?
  feedback_wrong         String?
  is_diagnostic          Boolean    @default(false)
  source                 TaskSource @default(HUMAN)
  created_at             DateTime   @default(now())

  attempts Attempt[]

  @@index([primary_skill, level_target])
  @@index([grade_band], type: Gin)
  @@map("tasks")
}

model DiagnosticSession {
  id                   String           @id @default(uuid())
  learner_id           String
  status               DiagnosticStatus @default(IN_PROGRESS)
  current_phase        DiagnosticPhase  @default(PHASE_A)
  phase_a_completed    Boolean          @default(false)
  phase_b_completed    Boolean          @default(false)
  weak_skills_detected String[]         // Populated after Phase A
  /// JSONB: { general_level, skill_levels, top_errors, priority_skills }
  result               Json?
  started_at           DateTime         @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?        @db.Timestamptz(6)

  learner  Learner   @relation(fields: [learner_id], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([learner_id, status])
  @@map("diagnostic_sessions")
}

model Plan {
  id              String       @id @default(uuid())
  learner_id      String
  template        PlanTemplate
  status          PlanStatus   @default(ACTIVE)
  is_active       Boolean      @default(true)
  priority_skills String[]     // ["S3","S5"]
  target_errors   String[]     // ["C1","C4"]
  daily_minutes   Int          // 10 / 15 / 20
  duration_days   Int          // 7 or 14
  source          PlanSource
  started_at      DateTime     @default(now()) @db.Timestamptz(6)
  ended_at        DateTime?    @db.Timestamptz(6)

  learner     Learner      @relation(fields: [learner_id], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  checkpoints Checkpoint[]

  @@index([learner_id, status])
  @@unique([learner_id, is_active])
  @@map("plans")
}

model Lesson {
  id                         String       @id @default(uuid())
  learner_id                 String
  plan_id                    String
  day_number                 Int          // 1–14
  primary_skill              SkillCode
  secondary_skill            SkillCode?
  session_length             Int          // 10 / 15 / 20
  lesson_goal                String?
  task_ids                   String[]     // Ordered task IDs
  estimated_duration_seconds Int
  status                     LessonStatus @default(PENDING)
  completed_tasks            Int          @default(0)
  total_tasks                Int
  accuracy                   Float?       // Populated on completion
  scheduled_date             DateTime     @db.Date
  started_at                 DateTime?    @db.Timestamptz(6)
  completed_at               DateTime?    @db.Timestamptz(6)

  learner  Learner   @relation(fields: [learner_id], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [plan_id],    references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([plan_id, day_number])
  @@index([learner_id, scheduled_date])
  @@map("lessons")
}

model Checkpoint {
  id             String              @id @default(uuid())
  learner_id     String
  plan_id        String
  task_ids       String[]
  /// JSONB: { skill_deltas, level_changes, new_plan_needed }
  result         Json?
  decision       CheckpointDecision?
  status         CheckpointStatus    @default(PENDING)
  scheduled_date DateTime            @db.Date
  completed_at   DateTime?           @db.Timestamptz(6)

  plan     Plan      @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([plan_id, status])
  @@map("checkpoints")
}

model Attempt {
  id                    String         @id @default(uuid())
  learner_id            String
  task_id               String
  lesson_id             String?
  diagnostic_session_id String?
  checkpoint_id         String?
  input_text            String
  score                 Float          // 0 | 0.25 | 0.5 | 0.75 | 1.0
  time_seconds          Int
  self_corrected        Boolean        @default(false)
  error_codes           String[]       // Quick lookup; detail in ErrorLog
  context               AttemptContext
  created_at            DateTime       @default(now()) @db.Timestamptz(6)

  learner            Learner            @relation(fields: [learner_id],            references: [id], onDelete: Cascade)
  task               Task               @relation(fields: [task_id],               references: [id])
  lesson             Lesson?            @relation(fields: [lesson_id],             references: [id], onDelete: SetNull)
  diagnostic_session DiagnosticSession? @relation(fields: [diagnostic_session_id], references: [id], onDelete: SetNull)
  checkpoint         Checkpoint?        @relation(fields: [checkpoint_id],         references: [id], onDelete: SetNull)
  error_logs         ErrorLog[]

  @@index([learner_id, created_at(sort: Desc)])
  @@index([learner_id, task_id])
  @@map("attempts")
}

model ErrorLog {
  id               String    @id @default(uuid())
  attempt_id       String
  error_code       ErrorCode
  severity         Int       // 1 = minor, 2 = rule-based, 3 = core
  position_in_word Int?
  expected_char    String?
  actual_char      String?
  context_word     String?

  attempt Attempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([attempt_id])
  @@index([error_code, attempt_id])
  @@map("error_logs")
}
